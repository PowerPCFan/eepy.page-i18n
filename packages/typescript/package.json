{
    "name": "@powerpcfan/eepy-page-i18n",
    "version": "0.1.6",
    "description": "i18n runtime and translation files for eepy.page",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js",
            "require": "./dist/server.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/server.ts --format esm,cjs --dts --sourcemap --no-config"
    },
    "dependencies": {
        "i18next": "^26.7.1",
        "i18next-icu": "^2.6.1",
        "intl-messageformat": "^12.1.4",
        "js-cookie": "^3.0.5"
    },
    "devDependencies": {
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^22.20.5",
        "tsup": "^8.3.6",
        "typescript": "^5.7.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
